[Unit]
Description=CHDevFlow Multi-Repository Supervised Hourly Dispatcher (DEACTIVATED)
Documentation=https://github.com/hallanbrito/CHDevFlow/blob/main/docs/CH/RUC-CH-AUTO-MULTI-01.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hallan
Group=hallan

WorkingDirectory=/home/hallan/CHDevFlow

Environment="PYTHONPATH=src:apps/bootstrap/sentinela/src"
Environment="CH_SENTINELA_DATA_DIR=/home/hallan/CHDevFlow/.ch_sentinela"
Environment="CH_DISPATCHER_MODE=DRY_RUN"
Environment="CH_EXTRA_COST_LIMIT_BRL=0.00"

ExecStart=/usr/bin/python3 -m chdevflow.core.multi_repo_supervisor --once --dry-run

TimeoutStartSec=900
StandardOutput=journal
StandardError=journal

ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/hallan/CHDevFlow/.ch_sentinela
NoNewPrivileges=true
PrivateTmp=true

[Install]
# DESATIVADO: Não habilitar
# WantedBy=multi-user.target
