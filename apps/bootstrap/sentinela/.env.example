# ==============================================================================
# CHDevFlow — Sentinela Python (.env.example)
# ==============================================================================
# ATENÇÃO: Nunca coloque tokens reais, senhas ou credenciais neste arquivo.
# A Sentinela utiliza a autenticação local já configurada no host via `gh auth status`.
# ==============================================================================

# Diretório base local para persistência de checkpoints e auditoria (padrão: .ch_sentinela)
CH_SENTINELA_DATA_DIR=.ch_sentinela

# Repositório canônico padrão
CH_SENTINELA_REPO=hallanbrito/CHDevFlow

# Número padrão do GitHub Project #2
CH_SENTINELA_PROJECT=2
