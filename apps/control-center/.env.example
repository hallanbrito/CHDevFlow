# Configurações de Rede Local (Host restrito a localhost - Decisão D01 e RNF-01)
CH_CC_HOST=127.0.0.1
CH_CC_PORT=8000

# Modo de Operação (LIVE_GITHUB ou DEMO_OFFLINE)
CH_CC_MODE=DEMO_OFFLINE

# Perfil Inicial de Projeto (chdevflow ou hallancraft)
CH_CC_PROJECT_PROFILE=chdevflow

# Diretório de persistência de dados locais de sessão (0o700)
CH_CC_DATA_DIR=.ch_control_center
